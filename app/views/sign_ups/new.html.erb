<% content_for(:title) { "Create your workspace" } %>

<div class="min-h-screen flex items-start pt-12 justify-center">
  <div class="px-10 py-8 w-full max-w-lg bg-white/90">
    <% unless @login_url %>
      <!-- Heading -->
      <div class="text-center mb-6">
        <h1 class="text-xl font-semibold text-gray-800">
          Create your workspace
        </h1>
        <p class="text-sm text-gray-500 mt-1">
          Set up your account and start managing compliance
        </p>
      </div>

      <% @sign_up&.errors&.full_messages&.each do |msg| %>
        <p class="text-red-500"><%= msg %></p>
      <% end %>

      <%= form_with model: @signup, url: sign_up_path, data: { turbo: false }, class: "space-y-5" do |form| %>

        <!-- Account Section -->
        <div>
          <h2 class="text-sm font-semibold text-gray-700 mb-2">
            Create your account
          </h2>

          <div class="space-y-3">
            <%= form.email_field :email_address,
                required: true,
                autocomplete: "username",
                placeholder: "Email address",
                class: "block w-full rounded-xl border-2 border-gray-300 px-4 py-2 focus:border-secondary focus:outline-none" %>

            <%= form.password_field :password,
                required: true,
                placeholder: "Password",
                maxlength: 32,
                class: "block w-full rounded-xl border-2 border-gray-300 px-4 py-2 focus:border-secondary focus:outline-none" %>

            <%= form.password_field :password_confirmation,
                required: true,
                placeholder: "Confirm password",
                maxlength: 32,
                class: "block w-full rounded-xl border-2 border-gray-300 px-4 py-2 focus:border-secondary focus:outline-none" %>
          </div>
        </div>

        <div class="pt-2 flex flex-col items-center">
          <%= form.button type: "submit",
              class: "group w-full px-4 py-3 flex items-center justify-center rounded-xl bg-primary-content text-white hover:bg-primary active:scale-95 transition" do %>

            <span class="text-lg font-semibold">Create workspace</span>

            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 ml-2 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"> <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /> </svg>
          <% end %>
        </div>

      <% end %>
    <% else %>
      <div class="text-center space-y-6">
        <div>
          <h2 class="text-xl font-semibold text-gray-800"> Your workspace is ready </h2>
          <p class="text-sm text-gray-500 mt-1">
            Save this link — you’ll use it to access your workspace later.
          </p>
        </div>
        <div class="relative bg-gray-100 rounded-xl border p-3 pr-12 text-sm break-all text-gray-700">

          <%= @login_url %>

          <!-- Copy button (right side) -->
          <button type="button" class="absolute right-2 top-1/2 -translate-y-1/2 bg-white border rounded-lg px-3 py-1 text-xs font-medium text-gray-700 hover:bg-gray-50 transition"
            onclick="
              navigator.clipboard.writeText('<%= j @login_url %>');
              this.innerText='Copied';
              setTimeout(() => this.innerText='Copy', 1500);
            "
          >
            Copy
          </button>

        </div>

          <%= link_to "Open workspace", @login_url,
            class: "w-full bg-primary-content text-white p-3 rounded-xl font-semibold hover:bg-primary transition" %>
      </div>
    <% end %>
  </div>
</div>