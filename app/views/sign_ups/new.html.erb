<% content_for :title, "Create Your Workspace" %>

<div class="min-h-screen flex items-start pt-12 justify-center">
  <div class="px-10 py-8 w-full max-w-lg bg-white/90">
    <!-- Heading -->
    <div class="text-center mb-6">
      <h1 class="text-xl font-semibold text-gray-800">
        Create your workspace
      </h1>
      <p class="text-sm text-gray-500 mt-1">
        Set up your account, a default user and start managing compliance
      </p>
    </div>

    <% @signup&.errors&.full_messages&.each do |msg| %>
      <p class="text-red-500"><%= msg %></p>
    <% end %>

    <%= form_with model: @signup, 
                  url: sign_up_path, 
                  data: { turbo: false }, 
                  class: "space-y-5" do |form| %>

      <div>
        <div>
          <h2 class="text-sm font-semibold text-gray-700 mb-2">
            Create Account
          </h2>

          <%= form.text_field :name,
              required: true,
              autocomplete: "organization",
              placeholder: "Business name",
              maxlength: 64,
              class: "block w-full rounded-xl border-2 border-gray-300 
                      px-4 py-2 focus:border-secondary focus:outline-none" %>
        </div>

        <div class="space-y-3 mt-8">
          <h2 class="text-sm font-semibold text-gray-700 mb-2">
            Create default owner profile
          </h2>

          <%= form.email_field :email_address,
              required: true,
              autocomplete: "username",
              placeholder: "Email address",
              class: "block w-full rounded-xl border-2 border-gray-300 
                      px-4 py-2 focus:border-secondary focus:outline-none" %>

          <%= form.password_field :password,
              required: true,
              placeholder: "Password",
              maxlength: 32,
              class: "block w-full rounded-xl border-2 border-gray-300 
                      px-4 py-2 focus:border-secondary focus:outline-none" %>

          <%= form.password_field :password_confirmation,
              required: true,
              placeholder: "Confirm password",
              maxlength: 32,
              class: "block w-full rounded-xl border-2 border-gray-300 
                      px-4 py-2 focus:border-secondary focus:outline-none" %>
        </div>
      </div>

      <div class="pt-2 flex flex-col items-center">
        <%= form.button type: "submit",
            class: "group w-full px-4 py-3 flex items-center justify-center rounded-xl 
                    bg-secondary text-white hover:bg-secondary/90 active:scale-95 transition" do %>

          <span class="text-lg font-semibold">Create workspace</span>

          <svg xmlns="http://www.w3.org/2000/svg" 
               class="h-6 w-6 ml-2 transition-transform group-hover:translate-x-1" 
               fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"> 
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /> 
          </svg>
        <% end %>
      </div>

    <% end %>
  </div>
</div>