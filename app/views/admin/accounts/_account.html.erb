<div class="flex-1 p-6 overflow-y-auto flex flex-col gap-6 panel-content" data-panel="security">

  <!-- Security -->
  <div id="security">
    <h2 class="text-xl font-bold text-gray-900">Security</h2>
    <p class="text-sm text-gray-500 mt-1">
      Customize how your workspace appears to users
    </p>
  </div>

  <div class="flex gap-4 border border-base-200 p-6 rounded-lg shadow-sm hover:shadow-md hover:-translate-y-px transition-all duration-300">
    <svg width="50" height="50" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg"> <circle cx="60" cy="60" r="55" stroke="#374151" stroke-width="4" fill="#F3F4F6"/> <line x1="40" y1="60" x2="80" y2="60" stroke="#9CA3AF" stroke-width="4" stroke-linecap="round"/> <circle cx="35" cy="60" r="18" fill="#3B82F6"/> <path d="M31 60L35 64L43 56" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/> <circle cx="85" cy="60" r="18" fill="#10B981"/> <path d="M81 60L85 64L93 56" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/> </svg>
    <%= form_with model: @account, url: admin_account_path, class:"w-full content-center", method: :patch, local: true,
        data: { controller: "autosave", action: "change->autosave#debouncedSubmit" } do |form| %>
      <div class="flex justify-between">
        <%= form.label :mfa_enabled, "Two-factor Authentication", class: "text-lg font-semibold cursor-pointer" %>
        <%= form.check_box :mfa_enabled, class: "toggle toggle-xl" %>
      </div>
      <div class="text-gray-500">Add an extra layer of security to all accounts by requiring a one-time password sent to user email address</div>
    <% end %>
  </div>

  <div class="flex gap-4 border border-base-200 p-6 rounded-lg shadow-sm hover:shadow-md hover:-translate-y-px transition-all duration-300">
    <svg width="50" height="50" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg"> <path d="M60 10L100 25V55C100 80 80 100 60 110C40 100 20 80 20 55V25L60 10Z" fill="white" stroke="#3B82F6" stroke-width="6"/> <rect x="40" y="50" width="40" height="30" rx="6" fill="#374151"/> <path d="M45 50V40C45 32 50 26 60 26C70 26 75 32 75 40V50" stroke="#374151" stroke-width="3" stroke-linecap="round"/> </svg>
    <%= form_with model: @account, url: admin_account_path, class:"w-full content-center", method: :patch, local: true,
        data: { controller: "autosave", action: "change->autosave#debouncedSubmit" } do |form| %>
      <div class="flex justify-between">
        <%= form.label :password_complexity, "Password Complexity", class: "text-lg font-semibold cursor-pointer" %>
        <%= form.check_box :password_complexity, class: "toggle toggle-xl" %>
      </div>
      <div class="text-gray-500">A minimum of 1 uppercase, 1 lowercase, 1 special character and 1 number will be enforced</div>
    <% end %>
  </div>

  <div class="flex gap-4 border border-base-200 p-6 rounded-lg shadow-sm hover:shadow-md hover:-translate-y-px transition-all duration-300">
    <svg width="50" height="50" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="60" cy="60" r="50" stroke="#D1D5DB" stroke-width="8" fill="#F9FAFB"/><path d="M60 10 A50 50 0 0 1 110 60" stroke="#EF4444" stroke-width="8" fill="none" stroke-linecap="round"/><circle cx="60" cy="60" r="6" fill="#374151"/><line x1="60" y1="60" x2="60" y2="35" stroke="#374151" stroke-width="4" stroke-linecap="round"/><line x1="60" y1="60" x2="85" y2="60" stroke="#374151" stroke-width="3" stroke-linecap="round"/> </svg>
    <%= form_with model: @account,
        url: admin_account_path,
        class:"w-full content-center", 
        method: :patch, 
        local: true,
        data: { controller: "autosave", action: "change->autosave#debouncedSubmit" } do |form| %>
        
        <div class="flex justify-between">
          <div class="flex flex-col">
            <%= form.label :session_timeout, "Session Timeout", class: "text-lg font-semibold cursor-pointer content-center" %>
            <div class="text-gray-500">All active session will expire after the value set. Users wil be required to relogin after a session has expired</div>
          </div>
          <%= form.select :session_timeout,
              Session.options_for_session_timeout,
              {},
              class: "select max-w-32 font-semibold" %>
          <% end %>
        </div>
  </div>

  <br>

  <!-- Branding -->
  <div id="branding">
    <h2 class="text-xl font-bold text-gray-900">Branding</h2>
    <p class="text-sm text-gray-500 mt-1">
      Customize how your workspace appears to users
    </p>
  </div>

  <%= form_with model: @account,
      url: admin_account_path,
      method: :patch,
      local: true,
      data: { controller: "autosave", action: "change->autosave#debouncedSubmit" },
      class: "flex flex-col gap-8" do |form| %>
      <%= hidden_field_tag :anchor, "branding" %>

    <!-- Logo Upload -->
    <div class="p-6 border border-base-200 rounded-lg shadow-sm hover:shadow-md transition-all">

      <h3 class="text-lg font-semibold">Logo</h3>
      <p class="text-sm text-gray-500 mb-4">
        Upload your company logo. This will appear in the navigation and reports.
      </p>

      <ul class="list-disc list-inside text-sm text-gray-500 mb-2">
        <li> Image type: PNG and JPG only </li>
        <li> Max file size: 15KB </li>
        <li> Recommended dimensions: 120x40px </li>
      </ul>

      <div class="flex items-center gap-8">
        
        <!-- Logo Preview -->
        <div class="relative group h-16 p-1 flex items-center justify-center overflow-hidden">
          <% if @account.logo.attached? %>
            <%= image_tag @account.logo, class: "object-contain h-[50px]", alt: "logo" %>

            <!-- Hover Delete Button -->
            <%= link_to purge_admin_account_path,
                data: { turbo_method: :delete, turbo_confirm: "Delete logo?" },
                class: "absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center" do %>
              <span class="px-3 py-1 text-xs font-medium text-white bg-red-600 rounded hover:bg-red-700"> Delete </span>
            <% end %>
          <% else %>
            <div class="h-[50px] w-28 flex flex-col items-center justify-center border border-dashed border-gray-300 rounded-xl bg-gray-50 text-gray-500">
              <span class="text-xs font-medium">Logo</span>
            </div>
          <% end %>
        </div>
          
        <%= form.file_field :logo, class: "file-input file-input-bordered" %>
      </div>
    </div>

    <!-- Colors -->
    <div class="border border-base-200 p-6 rounded-lg shadow-md hover:shadow-lg transition-all">
      <h3 class="text-lg font-semibold mb-4">Colors</h3>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

        <!-- Primary Color -->
        <div data-controller="color-sync">
          <label class="block text-sm font-medium text-gray-700 mb-1">
            Primary color
          </label>

          <div class="flex items-center gap-3">
            <%= form.color_field :primary_color,
                class: "w-12 h-10 rounded cursor-pointer",
                data: {
                  color_sync_target: "picker",
                  action: "input->color-sync#pickerChanged"
                } %>

            <%= form.text_field :primary_color,
                class: "input w-full",
                placeholder: "#000000",
                data: {
                  color_sync_target: "text",
                  action: "input->color-sync#textChanged"
                } %>
          </div>
        </div>

        <!-- Secondary Color -->
        <div data-controller="color-sync">
          <label class="block text-sm font-medium text-gray-700 mb-1">
            Secondary color
          </label>

          <div class="flex items-center gap-3">
            <%= form.color_field :secondary_color,
                class: "w-12 h-10 rounded cursor-pointer",
                data: {
                  color_sync_target: "picker",
                  action: "input->color-sync#pickerChanged"
                } %>

            <%= form.text_field :secondary_color,
                class: "input w-full",
                placeholder: "#ffffff",
                data: {
                  color_sync_target: "text",
                  action: "input->color-sync#textChanged"
                } %>
          </div>
        </div>

      </div>
    </div>
  <% end %>

  <br>
  
</div>