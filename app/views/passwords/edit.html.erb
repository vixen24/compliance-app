<% content_for(:title) { "Password Reset" } %>

<div class="h-screen login-bg">
  <div class="panel panel--centered mb-16 px-10 py-8 md:w-2/3 w-full mx-auto bg-white/85">
      <div class="justify-items-center p-2 pt-0" style="text-align: -webkit-center">
        <%= render "layouts/shared/our_logo" %>
      </div>

      <h1 class="text-normal text-black/60 font-light text-center">Reset your Password</h1>

      <div class="bg-amber-50/80 border border-amber-200 px-8 py-4 mt-4 rounded-lg">
      <p class="text-sm font-medium text-amber-800 mb-2">Password requirements</p>
      <ul class="text-sm text-amber-700 space-y-1 list-disc list-outside">
        <li>One uppercase, lowercase, number, and special character</li>
        <li>Do not reuse old password</li>
        <li>Both password and confirmation must match</li>
      </ul>
    </div>

    <script>
      function togglePassword(button) {
        const wrapper = button.closest(".input")
        const input = wrapper.querySelector("input")

        const eye = button.querySelector(".eye")
        const eyeOff = button.querySelector(".eye-off")

        const isHidden = input.type === "password"

        input.type = isHidden ? "text" : "password"

        eye.classList.toggle("hidden")
        eyeOff.classList.toggle("hidden")
      }
    </script>

    <%= form_with url: password_path(params[:token]), method: :put, class: "contents" do |form| %>
      <div class="my-3 mt-4">
        <label class="input relative">

          <svg class="h-[1em] opacity-50" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <g stroke-linejoin="round" stroke-linecap="round" stroke-width="2.5" fill="none" stroke="currentColor">
              <path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"></path>
              <circle cx="16.5" cy="7.5" r=".5" fill="currentColor"></circle>
            </g>
          </svg>

          <%= form.password_field :password,
            id: "password",
            required: true,
            autocomplete: "new-password",
            placeholder: "Enter your password",
            maxlength: 24,
            class: "text-base text-black/85 pr-10" %>

          <button
            type="button"
            onclick="togglePassword(this)"
            class="cursor-pointer absolute right-3 top-1/2 -translate-y-1/2 p-1.5"
            aria-label="Toggle password visibility">

            <svg id="eye" xmlns="http://www.w3.org/2000/svg" width="24" height="24"
              viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round"
              class="lucide lucide-eye h-4 w-4 text-black/85 hidden">
              <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>

            <svg id="eye-off" xmlns="http://www.w3.org/2000/svg" width="24" height="24"
              viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round"
              class="lucide lucide-eye-off h-4 w-4 text-black/60">
              <path d="M10.733 5.076A10.744 10.744 0 0 1 12 5c4.478 0 8.268 2.943 9.543 7a1 1 0 0 1 0 .696 10.75 10.75 0 0 1-4.043 5.145"></path>
              <path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"></path>
              <path d="M17.479 17.499A10.75 10.75 0 0 1 12 19c-4.478 0-8.268-2.943-9.543-7a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"></path>
              <path d="m2 2 20 20"></path>
            </svg>

          </button>
        </label>
      </div>

      <div class="my-3">
        <label class="input relative">

          <svg class="h-[1em] opacity-50" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <g stroke-linejoin="round" stroke-linecap="round" stroke-width="2.5" fill="none" stroke="currentColor">
              <path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"></path>
              <circle cx="16.5" cy="7.5" r=".5" fill="currentColor"></circle>
            </g>
          </svg>

          <%= form.password_field :password_confirmation,
            id: "password_confirmation",
            required: true,
            autocomplete: "off",
            placeholder: "Confirm password",
            maxlength: 24,
            class: "text-base text-black/85 pr-10" %>

          <button
            type="button"
            onclick="togglePassword(this)"
            class="cursor-pointer absolute right-3 top-1/2 -translate-y-1/2 p-1.5"
            aria-label="Toggle password visibility">

            <svg id="eye" xmlns="http://www.w3.org/2000/svg" width="24" height="24"
              viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round"
              class="lucide lucide-eye h-4 w-4 text-black/85 hidden">
              <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>

            <svg id="eye-off" xmlns="http://www.w3.org/2000/svg" width="24" height="24"
              viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round"
              class="lucide lucide-eye-off h-4 w-4 text-black/60">
              <path d="M10.733 5.076A10.744 10.744 0 0 1 12 5c4.478 0 8.268 2.943 9.543 7a1 1 0 0 1 0 .696 10.75 10.75 0 0 1-4.043 5.145"></path>
              <path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"></path>
              <path d="M17.479 17.499A10.75 10.75 0 0 1 12 19c-4.478 0-8.268-2.943-9.543-7a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"></path>
              <path d="m2 2 20 20"></path>
            </svg>

          </button>
        </label>
      </div>

      <div class="text-center">
        <%= form.submit "Reset Password", class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-black/95 hover:bg-black/85 text-white inline-block font-medium cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
