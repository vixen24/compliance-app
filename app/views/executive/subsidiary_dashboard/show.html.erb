<% content_for(:title) { "Subsidiary Dashbaord" } %>

<% content_for :left_sidebar do %>
  <%= render "executive/shared/left_sidebar" %>
<% end %>

<div class="flex flex-col">
  <header class="m-6">
    <div class="flex gap-6">
      <!--Title-->
      <div class="pr-2 flex-2">
        <h2 class="text-3xl font-black pt-2">
          Information Security Compliance at-a-Glance
        </h2>
        <p class="py-1">
          <div class="text-base-content/95">Monitor compliance posture and approval flow. Use filters to spotlight risk,  </div>
          <div class="text-base-content/95"> unblock approvals, and keep standards audit-ready</div>
        </p>
      </div>

      <div class="bg-primary-content/95 py-4 px-5 rounded-2xl flex-1">
        <!-- Team/Subsidiary -->
        <%= form_with url: executive_subsidiary_dashboard_path, 
                      method: :get, 
                      local: true, 
                      data: { 
                        controller: "autosave", 
                        action: "change->autosave#debouncedSubmit" 
                      } do |form| %>
            <%= hidden_field_tag :status, @status %>
            <%= hidden_field_tag :id, @assessment&.id %>
            <%= hidden_field_tag :framework, @framework&.id %>
          
          <fieldset class="mt-2">              
            <legend class="text-white font-medium mb-1.5">
              Select a country 
            </legend>
            <label for="team" class="select relative w-full">
              <%= render "icons/globe" %>
              <%= form.select :team,
                Current.account.teams.order(:name).map { |t| [t.name, t.slug] },
                { selected: @team&.slug },
                { class: "text-base font-medium focus:outline-none" } 
              %>
            </label>
          </fieldset>
          
        <% end %>
      </div>

      <!--Subsidiary Insight-->
      <div class="darkish py-4 px-6 rounded-2xl flex-1">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border bg-white border-white">
          <svg xmlns="http://www://w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="#FFC600" stroke="#FFC600" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles h-4 w-4 text-accent"> <path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path> <path d="M20 3v4"></path> <path d="M22 5h-4"></path> <path d="M4 17v2"></path> <path d="M5 18H3"></path> </svg>
          <span class="text-xs font-semibold text-black/80">Executive Insights</span>
        </div>
        <div class="mt-3 text-white">
          <ul class="space-y-2">
            <li class="flex items-start gap-2">
              <span class="">-</span><span><%= subsidiary_insight(@metrics.compliance_percentage) %></span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </header>

  <!--Filters-->
  <%= form_with url: executive_subsidiary_dashboard_path, method: :get, local: true,
    data: { controller: "autosave", action: "change->autosave#debouncedSubmit" } do |form| %>
    <%= hidden_field_tag :team, @team&.slug %>

    <div class="flex rounded-xl p-4 px-6 mx-6 mb-6 border 
              border-base-200 items-end shadow-sm">
      <div class="self-center inline-flex gap-2">
          <%= render "icons/filter" %>
          <span class="font-medium text-base-content/95"> 
            Filters 
          </span>
          <div class="w-px h-[26px] mx-2.5 bg-base-content/30"></div>
      </div>
        
      <div class="flex gap-8 w-full ml-2">
        
        <fieldset>
          <%= form.select :status,
            Assessment.statuses.keys.map { |k| [k.humanize, k] },
            { selected: @status },
            {
              class: "select min-w-[240px] bg-base-200 rounded-lg"
            } %>
        </fieldset>
        
        <fieldset class="w-full">
          <%= form.select :id,
            @metrics.assessments.map { |a| [a.name, a.id] },
            { selected: @metrics.assessment&.id || "" },
            {
              class: "select w-full bg-base-200 rounded-lg"
            } %>
        </fieldset>
        
        <fieldset class="w-full">
          <%= form.select :framework,
            (@metrics.frameworks || []).map { |f| [f.code, f.id] },
            { include_blank: "All Frameworks", selected: @metrics.framework&.id },
            {
              class: "select w-full bg-base-200 rounded-lg"
            } %>
        </fieldset>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 m-6 mt-0">
    <% subsidiary_dashboard_cards(@metrics).each do |card| %>
      <%= render "card", card:card %>
    <% end %>
  </div>

  <!---Charts -->
  <div class="flex w-full flex-wrap min-[1800]:flex-nowrap gap-8 px-6">

    <!--Compliance chart-->
    <div class="flex flex-nowrap max-[800]:flex-wrap flex-1 self-start border border-base-300 shadow-md transition-shadow px-4 py-1 rounded-lg w-auto" style="">
      <div data-controller="compliance-chart" data-compliance-chart-values-value="<%= @metrics.status_values.to_json %>" 
          data-compliance-chart-labels-value="<%= @metrics.status_labels.to_json %>" class="flex-none">
      </div>

      <div class="flex-1 min-w-0 overflow-hidden pr-4 flex flex-col gap-2 place-content-center justify-center">

        <% colors = %w[green yellow red blue] %>

        <% @metrics.status_labels&.zip(@metrics.status_values, colors)&.each do |label, value, color| %>
          <!-- Legend with Linear Progress Bars -->
            <div class="legend-item">
              <div class="legend-header">
                <div class="flex items-center gap-2 text-sm font-semibold">
                  <span class="dot <%= color %>"></span> 
                  <%= button_to Answer.status_label(label).titleize,
                    executive_subsidiary_dashboard_path,
                    method: :get,
                    params: { 
                      team: @team,
                      status: @status,
                      id: @assessment&.id,
                      framework: @framework,
                      answer_status: label
                      },
                    class: "border-0 bg-transparent cursor-pointer" %>
                </div>

                <% width = number_to_percentage((value.to_f / @metrics.total_framework_excluding_not_applicable) * 100, precision: 0) || "0%" %>
                <span><%= value %> (<%= width %>)</span>
              </div>
              <div class="progress">
                <div class="progress-fill <%= color %>" style="width: <%= width %>"></div>
              </div>
            </div>
          <% end %>
      </div>
    </div>
    
    <!--Workflow chart-->
    <div class="flex flex-nowrap max-[800]:flex-wrap flex-1 self-center border border-base-300 shadow-md transition-shadow px-4 py-1 rounded-lg w-auto" style="">
      <div data-controller="workflow-chart" data-workflow-chart-values-value="<%= @metrics.state_values.to_json %>" 
          data-workflow-chart-labels-value="<%= @metrics.state_labels.to_json %>" class="flex-none">
      </div>

      <div class="flex-1 min-w-0 overflow-hidden pr-4 flex flex-col gap-2 place-content-center justify-center">

        <% colors = %w[green yellow red blue] %>

        <% @metrics.state_labels&.zip(@metrics.state_values, colors)&.each do |label, value, color| %>
          <!-- Legend with Linear Progress Bars -->
            <div class="legend-item">
              <div class="legend-header">
                <div class="flex items-center gap-2 text-sm font-semibold">
                  <span class="dot <%= color %>"></span> 
                  <%= button_to Answer.state_key_from_label(label).titleize,
                    executive_subsidiary_dashboard_path,
                    method: :get,
                    params: { 
                      team: @team,
                      status: @status,
                      id: @assessment&.id,
                      framework: @framework,
                      answer_state: label
                    },
                    class: "border-0 bg-transparent cursor-pointer" %>
                </div>

                <% width = number_to_percentage((value.to_f / @metrics.total[:control_by_framework]) * 100, precision: 0) || "0%" %>
                <span><%= value %> (<%= width %>)</span>
              </div>
              <div class="progress">
                <div class="progress-fill <%= color %>" style="width: <%= width %>"></div>
              </div>
            </div>
          <% end %>
      </div>
    </div> 
  </div>

  <!--Controls Summary-->
  <div id="controls-summary" class="rounded-lg m-6 border border-base-300/80 overflow-hidden" data-controller=<%= "scroll-into-view" if @metrics.answer_status || @metrics.answer_state %>>
    <div class="bg-base-200 border-b border-base-300/80 px-8 py-1 text-lg font-medium">
      <% if @metrics.answer_status %>
        Showing controls with compliance status: <%= Answer.status_label(@answer_status).titleize %>
      <% elsif @metrics.answer_state %>
        Showing controls with workflow: <%= @metrics.answer_state.titleize %>
      <% else %>
        Showing all controls in assessment
      <% end %>
    </div>

    <div id="subsidiary-dashboard-controls-table">
      <div class="">
        <div class="grid grid-cols-[0.25fr_8fr_1fr_1fr] gap-6 border-b border-base-200 px-8 py-2 font-medium">
          <div>ID</div>
          <div>Control</div>
          <div>Status</div>
          <div>Workflow </div>
        </div>
        <% @metrics.filtered_controls_per_page.each do |control| %>
        <div class="grid grid-cols-[0.25fr_8fr_1fr_1fr] space-x-2 gap-6 border-b border-base-200 px-8 py-2 hover:bg-base-200">
          <div><%= control.control_id %></div>
          <div class="">
            <div class="font-semibold"> <%= control.question %> </div>
            <div class="flex flex-wrap gap-2 py-2">
              <%= render_full_framework_code_badges(@assessment, control) %>
            </div>
          </div>
          <div class="uppercase shrink <%= answer_status_classes(control.answer.status_label) %>">
            <div class="truncate max-w-[60px] md:max-w-[100px] lg:max-w-[120px]  block">
              <%= control.answer.status_label %>
            </div>
          </div>
          <div class="uppercase shrink <%= answer_state_classes(control.answer) %>">
            <div class="truncate max-w-[60px] md:max-w-[100px] lg:max-w-[120px]  block">
              <%= control.answer.state_label %>
            </div>
          </div>
        </div>
        <% end %>
      </div>
      <!--Control Pagination-->
      <div class="flex items-center gap-4 text-sm py-2 px-6 border-t border-base-200">
        <div>
          <%= form_with url: executive_subsidiary_dashboard_path, method: :get, class: "flex items-center gap-2" do |form| %>
            <%= form.hidden_field :team, value: @team.slug %>
            <%= form.hidden_field :status, value: @metrics.status %>
            <%= form.hidden_field :id, value: @metrics.assessment&.id %>
            <%= form.hidden_field :framework, value: @metrics.framework.id.to_s if @metrics.framework %>
            <%= form.hidden_field :answer_state, value: @metrics.answer_state %>
            <%= form.hidden_field :answer_status, value: @metrics.answer_status %>
            <%= form.hidden_field :page, value: @metrics.page %>
      
            <%= select_tag :per_page, options_for_select([10, 30, 60, 80], @metrics.per_page),
                class: "select min-w-18 h-8",
                data:{ turbo_stream: true },
                onchange: "this.form.submit()" %>
          <% end %>
        </div>
      
        <% control_count = @metrics.filtered_controls.size %>
        <% total_pages = (control_count.to_f / @metrics.per_page).ceil %>
        <div class="flex flex-1 items-center">
          <div class="flex gap-4 m-auto items-center">
            <%= link_to "Previous", executive_subsidiary_dashboard_path(
                team: @team.id,
                status: @metrics.status,
                id: @metrics.assessment&.id,
                framework: @metrics.framework,
                answer_state: @metrics.answer_state,
                answer_status: @metrics.answer_status,
                page: @metrics.page - 1,
                per_page: @metrics.per_page
              ),
              data:{ turbo_stream: true },
              class: "btn btn-sm #{'invisible' if @metrics.page <= 1}"
            %>
            <span class="font-semibold">
              <%= @metrics.page %> of <%= total_pages %>
            </span>
            <%= link_to "Next", executive_subsidiary_dashboard_path(
                team: @team.slug,
                status: @metrics.status,
                id: @metrics.assessment&.id,
                framework: @metrics.framework,
                answer_state: @metrics.answer_state,
                answer_status: @metrics.answer_status,
                page: @metrics.page + 1,
                per_page: @metrics.per_page,
              ),
              data:{ turbo_stream: true },
              class: "btn btn-sm #{'invisible' if @metrics.page >= total_pages}"
            %>
          </div>
          <span class="font-semibold pr-2">
            <%=control_count%> Controls
          </span>
        </div>
      </div>
    </div>
  </div>
</div>