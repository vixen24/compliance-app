<% content_for(:title) { "Dashboard" } %>

<% content_for :left_sidebar do %>
  <%= render "layouts/shared/left_sidebar" %>
<% end %>

<div class="flex flex-col">
  <header class="m-6">
    <div class="flex gap-6">
      <!--Title-->
      <div class="pr-2 flex-2">
        <h2 class="text-3xl font-black pt-2 dark:text-white"> 
          Information Security Compliance at-a-Glance 
        </h2>

        <p class="py-1">
          <div class="text-base-content/95">
            Monitor compliance posture and approval flow. Use filters to spotlight risk,  
          </div>
          <div class="text-base-content/95"> 
            unblock approvals, and keep standards audit-ready
          </div>
        </p>
      </div>

      <!--Subsidiary Insight-->
      <div class="darkish py-4 px-5 rounded-lg flex-1">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border bg-white border-white border-border/60 bg-card/40">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="#FFC600" stroke="#FFC600" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles h-4 w-4 text-accent"> <path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path> <path d="M20 3v4"></path> <path d="M22 5h-4"></path> <path d="M4 17v2"></path> <path d="M5 18H3"></path> </svg>
          <span class="text-xs font-bold text-black/85">Quick Insights</span>
        </div>
        <div class="mt-3 text-white">
          <ul class="space-y-2">
            <li class="flex items-start gap-2">
              <span>-</span><span><%= subsidiary_insight(@metrics.compliance_percentage) %></span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </header>

  <%= render "filter" %>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 px-6 pb-0 pt-8">
    <%= render partial: "card", collection: dashboard_cards(@metrics), as: :card %>
  </div>

  <%= render "charts"%>
  <%= render "controls_table"%>
</div>