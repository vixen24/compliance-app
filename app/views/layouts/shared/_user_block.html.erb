<div class="flex flex-row gap-3 items-center p-2 rounded-lg bg-base-300">
  <%= render "icons/avatar", user: Current.user %>
  <div class="overflow-hidden">
    <div class="leading-4 text-sm font-medium truncate">
      <%= Current.user.name || Current.user.email_address %>
    </div>
    <div class="leading-4 text-sm">
      <%= Current.user.role.capitalize %>
    </div>
  </div>
</div>