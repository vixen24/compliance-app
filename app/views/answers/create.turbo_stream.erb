<% control = @answer.assessment_control %>
<% assessment = @answer.assessment %>

<% [1, 2].each do |suffix| %>
  <%= turbo_stream.replace nested_dom_id(assessment, control, suffix) do %>
    <%= render "answers/state", 
      control: control, 
      assessment: assessment,
      suffix: suffix 
    %>
  <% end %>
<% end %>

<%= turbo_stream.replace nested_dom_id(assessment, control, "answer") do %>
  <%= render "answers/form", 
    control: control,
    assessment: assessment
  %>
<% end %>