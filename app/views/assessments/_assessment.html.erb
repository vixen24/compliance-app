<%= link_to team_assessment_path(assessment.team, assessment.slug) do %>
  <div class="border border-base-200 shadow-md inset-shadow-2xs p-6 rounded-lg">
    <div class="flex flex-col gap-2 justify-between flex-wrap">
      <div>
        <div class="flex gap-2 justify-between items-center">
          <div class="text-lg text- font-medium">
            <%= assessment.name %>
          </div>
          <div class="badge <%= assessment.open? ? 'badge-success' : 'badge-error' %> 
                      self-start px-2 rounded-xl">
            <%= assessment.status.to_s.capitalize %>
          </div>
        </div>
      </div>
      <div class="flex flex-wrap gap-2 flex-1 h-max">
        <%= render_framework_code_badges(assessment) %>
      </div>   
    </div>
  </div>
<% end %>