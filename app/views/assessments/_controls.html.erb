<% if @controls.present? %>
  <ul id="controls" class="" data-controller="selectable-card" data-selectable-card-selected-card-id-value="<%= @control.control_id %>">
  <% @controls.each do |control| %>
    <li class="bg-base-100 rounded-lg my-2 border border-base-content/10 card" data-card-id="<%= control.control_id %>" 
        data-selectable-card-target="card" data-action="click->selectable-card#select">
      <%= link_to team_assessment_path(Current.team, @assessment, control: control, page: @page, per_page: @per_page, framework: @framework, answer_state: @answer_state, q: @q),
          class: "block focus-visible:outline-2 focus-visible:outline-base-content rounded-lg focus-visible:outline-offset-3",  
          data: { turbo_stream: true } do %>
        <div class="flex flex-col py-2.5 px-3">
          <div class="flex flex-row justify-between gap-x-2 gap-y-0">
            <div class="tooltip tooltip-bottom before:z-2" data-tip="<%= control&.question %>" style="--tooltip-delay: 5000ms;">
              <div class="font-medium truncate inline-block max-w-xs">
                <%= control&.question %>
              </div>
            </div>
            <%= render "answers/state", assessment: @assessment, control: control, suffix: 2 %>
          </div>
          <div class="text-xs text-gray-500 pt-0.5">C-<%= control.control_id.to_s.rjust(4, "0") %></div>
        </div>
      <% end %>
    </li>
  <% end %>
  </ul>
<% else %>
  <div class="text-center text-lg">
    <div class="font-medium">No result for the selected filter</div>
    <%=link_to "Clear filter", team_assessment_path, class:"text-sm text-blue-500 hover:underline" %>
  </div>
<% end %>
