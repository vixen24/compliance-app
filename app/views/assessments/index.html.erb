<% content_for :title, "Subsidiary Assessments" %>

<% content_for :left_sidebar do %>
  <%= render "layouts/shared/left_sidebar" %>
<% end %>

<div class="h-screen overflow-y-auto">
  <header class="flex px-6 py-3 justify-between 
                 items-center border-b border-base-300">
    <div class="">
      <h2 class="text-xl font-semibold">
        Assessments
      </h2>
      <p class="text-base-content/80">
        View, track, and complete your assessments
      </p>
    </div>

    <%= render "assessments/avatar_group" %>
  </header>
  <section class="grid lg:grid-cols-4 gap-6 m-6">
    <%= render @assessments %>
  </section>
</div>