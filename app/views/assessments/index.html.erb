<% content_for :title, "Subsidiary Assessments" %>

<% content_for :left_sidebar do %>
  <%= render "layouts/shared/left_sidebar" %>
<% end %>

<div class="h-screen overflow-y-auto">
  <header class="flex m-6 justify-between items-center">
    <div class="">
      <h2 class="text-2xl font-bold">
        Assessments
      </h2>
      <p class="text-base-content/80">View, track, and complete your assessments</p>
    </div>

    <%= link_to "Create New Assessment", new_team_assessment_path,
      class: "btn bg-primary-content focus:bg-primary rounded-lg text-gray-100",
      hidden: !Current.user.can_create_assessment? %>
  </header>
  <section class="grid grid-cols-3 gap-6 px-6">
    <%= render @assessments %>
  </section>
</div>